# sectop user helper: names the processes in GNOME Shell's shared cgroup for the
# firewall screen (socket inode -> pid, comm). Runs as the login user %i, reads only
# that user's own processes' fds. No capabilities, no network. %i = the desktop user
# (install.sh --desktop-user), who needs no sectop group.
# docs/architecture.md (Privilege split), docs/install.md
[Unit]
Description=sectop user helper for %i (socket owners in GNOME Shell's cgroup)
Documentation=file:/usr/local/lib/sectop/docs/install.md
# the path InaccessiblePaths= hides exists before the namespace is set up
After=sectop.service

[Service]
Type=exec
User=%i
# primary group sectop-feed: the runtime dir and the helper's files get it, the collector
# reads them (SupplementaryGroups=). No member has it: not handed to the login user.
Group=sectop-feed
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/sectop/bin/sectop-user
Restart=on-failure
RestartSec=5s
# /run/sectop-user/%i: %i:sectop-feed 0750, made by systemd (User= / Group=)
RuntimeDirectory=sectop-user/%i
RuntimeDirectoryMode=0750
UMask=0027
# the collector's state: never needed here. Extra layer only: the guard is group sectop
# (the desktop user is no member). Applies to what exists at start (a collector restart
# makes a new /run/sectop); '-' = fine when missing.
# Not the whois socket: hiding a file means a bind mount over it, and SELinux refuses
# init_t mounton on a var_run_t sock_file (AVC, 2026-11-06) -> 226/NAMESPACE, the helper
# never starts. The socket's own mode guards it: root:sectop 0660.
InaccessiblePaths=-/run/sectop

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# default, not invisible: the helper reads /proc/<pid>/fd of its own user's processes
ProtectProc=default
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# no RemoveIPC=: it would remove the login user's own IPC objects on stop
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=32M
TasksMax=4

[Install]
WantedBy=multi-user.target
