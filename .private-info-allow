# Reviewed hits of check-private-info.sh (silverblue-cis-hardening/tools) that
# are fine in this repo. Format and rules: the header of that script.
#   <label> <path glob> <value regex>     full match, case-insensitive
# Keep it short: every line hides something from the check.

# --- this machine (the script reads these live) ---
# Login name: a common word. auditd writes "(null)" for an empty field.
username   *        \(null\)
username   tests/*  (?:/var)?/home/null|user=null
home-path  tests/*  /var/home/null
# Home LAN (private /24) and the wifi / cable card names: low risk, kept as real
# examples. The local-ip rule is used only while the current address is in the repo.
local-ip   *        192\.168\.8\.\d{1,3}
iface      *        wlo1|enp44s0

# --- generic patterns ---
# Private and special ranges written without a prefix: RFC 1918, CGNAT,
# link-local, multicast. The script only passes them as "<net>/<prefix>".
ipv4  *  (?:10|127)(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2}|100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])(?:\.\d{1,3}){2}|169\.254(?:\.\d{1,3}){2}|2(?:2[4-9]|3\d)(?:\.\d{1,3}){3}
# Public resolvers (Cloudflare, Google, Quad9) and RIPE NCC: examples, lookup tests.
ipv4  *  1\.1\.1\.1|8\.8\.8\.\d{1,3}|8\.8\.0\.0|9\.9\.9\.9|149\.112\.112\.11|193\.0\.[067]\.\d{1,3}
# Made-up addresses.
ipv4  *        1\.2\.3\.\d{1,3}
ipv4  tests/*  4\.4\.4\.4|5\.6\.7\.8|8\.0\.0\.0|8\.1\.2\.3|41\.[01]\.[01]\.[01]|160\.0\.0\.0|198\.51\.0\.[56]
# systemd template units (user@1000.service ...) look like mail addresses.
email  *  [\w.:-]+@[\w.-]*\.(?:service|socket|scope|slice|target|timer|mount)
# Public abuse contacts in RDAP answers.
email  tests/test_lookup.py  abuse@ripe\.net|network-abuse@google\.com
# Made-up MACs: locally administered 02:..., QEMU 52:54:00:...
mac-addr  tests/*  02:00:00:00:00:0\d|52:54:00:(?:00:00:0\d|12:34:56|ab:cd:ef)|aa:bb:cc:dd:ee:ff
# Made-up makers 00:00:0N (tests/fixtures/oui.txt) and fixed group addresses (broadcast,
# mDNS 01:00:5e:00:00:fb, IPv6 all-nodes 33:33:00:00:00:01): the same on every LAN.
mac-addr  tests/*  00:00:0\d(?::[0-9a-f]{2}){3}|ff:ff:ff:ff:ff:ff|01:00:5e:00:00:fb|33:33:00:00:00:01
# Made-up UUIDs.
uuid  tests/*  01234567-89ab-4cde-8f01-23456789abcd|0a0a0a0a-0000-4000-8000-000000000001|0b0b0b0b-0000-4000-8000-000000000002|11111111-2222-[34]333-[48]444-555555555555|12345678-9abc-def0-1234-56789abcdef0|123e4567-e89b-12d3-a456-426614174000|aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee
# Fixed GUIDs, the same on every machine: EFI global variables; Intel MEI HDCP
# and PXP clients (kernel drivers/misc/mei).
uuid  *                 8be4df61-93ca-11d2-aa0d-00e098032b8c
uuid  tests/fixtures/*  b638ab7e-94e2-4ea2-a552-d1c54b627f04|fbf6fcf1-96cf-4e2e-a6a6-1bab8cbe36b1
# Terminal scope ids (ptyxis-spawn-<uuid>.scope): random per terminal window.
uuid  tests/fixtures/security/*  11a65ea7-d27c-408c-97fb-fc23916e6f2f|5b4252ef-cf15-41e0-a315-01989acbde94|c50b64c9-b0ea-491f-80f8-92d1237b51e5
# A made-up /etc/passwd.
generic-secret  tests/test_posture.py  passwd".*
